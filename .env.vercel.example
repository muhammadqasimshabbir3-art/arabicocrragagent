# Copy into Vercel → Project Settings → Environment Variables
# (Production + Preview). Then Redeploy — Vite bakes env at build time.

VITE_LANGGRAPH_API_URL=https://arabicocrragagent-production.up.railway.app
VITE_LANGGRAPH_ASSISTANT_ID=agent

VITE_STACK_VECTOR_DB=Chroma
VITE_STACK_EMBEDDINGS=BAAI/bge-m3
VITE_STACK_OCR=Digital text (pypdf)

# NEVER set secrets here (no LangSmith / Groq / Qdrant keys in VITE_*)
