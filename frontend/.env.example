# Arabic Document Intelligence — Frontend Environment Variables
# Set these in Vercel: Project Settings → Environment Variables

# ─── Backend URL (Vercel production) ──────────────────────────────────────────
# Use /api on Vercel — vercel.json proxies /api → Railway (avoids CORS).
# VITE_LANGGRAPH_API_URL=/api
#
# Direct Railway URL for local/dev without proxy:
# VITE_LANGGRAPH_API_URL=https://your-langgraph-host.up.railway.app

# Assistant / graph ID (must match the key in langgraph.json → "graphs")
VITE_LANGGRAPH_ASSISTANT_ID=agent

# ─── LangSmith API key ────────────────────────────────────────────────────────
# Required if the LangGraph server runs in authenticated mode.
VITE_LANGSMITH_API_KEY=

# ─── Optional form defaults ───────────────────────────────────────────────────
VITE_DEFAULT_USER_INPUT=ما موضوع هذا المستند؟

# ─── Stack labels (shown in UI; match backend .env) ───────────────────────────
VITE_STACK_VECTOR_DB=Chroma · data/chroma
VITE_STACK_EMBEDDINGS=BAAI/bge-m3
VITE_STACK_OCR=Qari-OCR v0.3
