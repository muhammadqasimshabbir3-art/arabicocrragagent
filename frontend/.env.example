# Frontend — Vercel Root Directory = frontend (uses vercel.json here).
# Local: VITE_* may also be set in the repo-root .env (vite envDir = parent).

# Production (Vercel build-time — also set in Vercel dashboard):
VITE_LANGGRAPH_API_URL=https://arabicocrragagent-production.up.railway.app
# Local only:
# VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024

VITE_LANGGRAPH_ASSISTANT_ID=agent
VITE_DEFAULT_USER_INPUT=ما موضوع هذا المستند؟

VITE_STACK_VECTOR_DB=Chroma · src/data/chroma
VITE_STACK_EMBEDDINGS=BAAI/bge-m3
VITE_STACK_OCR=Digital text (pypdf)
