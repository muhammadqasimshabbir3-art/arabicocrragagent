# Backend env template (src/).
# Local: copy to repo-root .env →  cp src/.env.example ../.env
# Railway: prefer deploy/.env.railway.example

GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant / llama-3.3-70b-versatile (2026-08-16).
# Default: openai/gpt-oss-120b (best free/dev accuracy for Arabic RAG).
# Faster/cheaper: openai/gpt-oss-20b
# Multilingual preview: qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arabic-doc-intelligence

OCR_ENGINE=digital

EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# MODELS_DIR=models
# EMBEDDING_MODEL_PATH=models/bge-m3

CHUNK_STRATEGY=page_aware
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
SUMMARY_MAX_CHARS=48000

VECTORSTORE_BACKEND=chroma
# VECTORSTORE_PERSIST_DIR=data/chroma

QDRANT_URL=
QDRANT_API_KEY=
KNOWLEDGE_COLLECTION=wathiqa_knowledge

RETRIEVAL_TOP_K=8
RETRIEVAL_MODE=hybrid
HYBRID_FUSION=rrf
ENABLE_QUERY_REWRITE=true
ENABLE_RERANKER=true
ENABLE_SPELLING_CORRECTOR=true
ENABLE_QUERY_BOOSTER=true
MAX_DOCUMENT_BYTES=52428800

LOG_LEVEL=INFO
LOG_FORMAT=text
VALIDATE_SETTINGS_ON_STARTUP=false

LANGGRAPH_PORT=2024
STREAMLIT_PORT=8501
FRONTEND_PORT=5173

CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:2024,http://127.0.0.1:2024,https://arabicocrragagent.vercel.app,https://smith.langchain.com
