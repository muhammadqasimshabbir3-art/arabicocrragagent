# Railway → Service → Variables
# Set Railway "Root Directory" to: src
# Guide: src/deploy/README.md

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

OCR_ENGINE=digital

EMBEDDING_MODEL_ID=BAAI/bge-m3
MODELS_DIR=/deps/ArabicOCRRAGAgent/models
EMBEDDING_MODEL_PATH=/deps/ArabicOCRRAGAgent/models/bge-m3

VECTORSTORE_BACKEND=chroma
VECTORSTORE_PERSIST_DIR=/deps/ArabicOCRRAGAgent/data/chroma
KNOWLEDGE_COLLECTION=wathiqa_knowledge

VALIDATE_SETTINGS_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_FORMAT=json
PORT=8000

# Include your Vercel origin(s). Example:
CORS_ALLOW_ORIGINS=https://YOUR-APP.vercel.app,https://YOUR-APP-git-main-YOURTEAM.vercel.app,https://smith.langchain.com
