# Railway → Service → Variables
# Set Railway "Root Directory" to: src
# Guide: src/deploy/README.md
#
# REQUIRED for langchain/langgraph-api image (Postgres + Redis):
# 1) Railway → New → Database → PostgreSQL  (same project as agent)
# 2) Railway → New → Database → Redis
# 3) Agent → Variables → Add Reference (UI). Match YOUR service names.
#    Dockerfile entrypoint also accepts DATABASE_URL / REDIS_URL aliases.

DATABASE_URI=${{Postgres.DATABASE_URL}}
REDIS_URI=${{Redis.REDIS_URL}}
# Or Railway defaults (aliased automatically):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

# REQUIRED for langchain/langgraph-api image (license check at startup).
# Get from https://smith.langchain.com → API Keys (org needs LangGraph Deployments access).
# 403 Forbidden = bad/expired key OR plan without LangGraph Cloud access.
LANGSMITH_API_KEY=
# Enterprise self-host (if you have one):
# LANGGRAPH_CLOUD_LICENSE_KEY=
# Do NOT set LANGSMITH_ENDPOINT / LANGCHAIN_ENDPOINT unless you use EU/self-hosted Smith.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

OCR_ENGINE=digital

EMBEDDING_MODEL_ID=BAAI/bge-m3
MODELS_DIR=/deps/ArabicOCRRAGAgent/models
EMBEDDING_MODEL_PATH=/deps/ArabicOCRRAGAgent/models/bge-m3

VECTORSTORE_BACKEND=chroma
VECTORSTORE_PERSIST_DIR=/deps/ArabicOCRRAGAgent/data/chroma
KNOWLEDGE_COLLECTION=wathiqa_knowledge

VALIDATE_SETTINGS_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_FORMAT=json
PORT=8000

# Production UI: https://arabicocrragagent.vercel.app
# No trailing slash. Add Preview domains if you use them.
CORS_ALLOW_ORIGINS=https://arabicocrragagent.vercel.app,https://smith.langchain.com
