# Arabic Document Intelligence Agent — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ─── Required: Groq LLM ───────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

# ─── Optional: LangSmith tracing / authenticated LangGraph ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arabic-doc-intelligence

# ─── OCR ──────────────────────────────────────────────────────────────────────
# qari (default) | ain | digital
OCR_ENGINE=qari
OCR_MODEL_ID=NAMAA-Space/Qari-OCR-v0.3-VL-2B-Instruct
OCR_MAX_TOKENS=2000
OCR_DEVICE=auto

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# ─── Chunking & retrieval ─────────────────────────────────────────────────────
# page_aware | recursive | layout_aware | semantic
CHUNK_STRATEGY=page_aware
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Vector DB backend: chroma | faiss | qdrant
VECTORSTORE_BACKEND=chroma

# Chroma local persistence (used when VECTORSTORE_BACKEND=chroma)
VECTORSTORE_PERSIST_DIR=data/chroma

# Qdrant (used when VECTORSTORE_BACKEND=qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Seeded knowledge corpus for direct chat questions (no PDF upload required)
KNOWLEDGE_COLLECTION=wathiqa_knowledge

RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid
ENABLE_RERANKER=false
RERANKER_BACKEND=lexical
MAX_DOCUMENT_BYTES=52428800
INDEX_CACHE_SIZE=8

# ─── Logging & local service ports ────────────────────────────────────────────
LOG_LEVEL=INFO
LANGGRAPH_PORT=2024
STREAMLIT_PORT=8501
FRONTEND_PORT=5173

# ─── CORS (LangGraph API — comma-separated, no spaces) ────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:2024,http://127.0.0.1:2024,https://smith.langchain.com

# ─── Frontend (Vite loads these from the repo root via envDir) ────────────────
# VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024
VITE_LANGGRAPH_ASSISTANT_ID=agent
VITE_LANGSMITH_API_KEY=
VITE_DEFAULT_USER_INPUT=ما موضوع هذا المستند؟
VITE_DEFAULT_WEB_SEARCH=false

# Stack labels in UI
VITE_STACK_VECTOR_DB=Chroma · data/chroma
VITE_STACK_EMBEDDINGS=BAAI/bge-m3
VITE_STACK_OCR=Qari-OCR v0.3
