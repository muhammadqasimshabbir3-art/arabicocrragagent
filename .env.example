# Monorepo env for local ./setup.sh and ./start.sh
# Backend template (also used on Railway): src/.env.example
# Frontend (Vercel): frontend/.env.example + .env.vercel.example
#
#   cp .env.example .env
#   # or: cp src/.env.example .env
# Then set GROQ_API_KEY.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

OCR_ENGINE=digital

EMBEDDING_MODEL_ID=BAAI/bge-m3
# Defaults resolve under src/models and src/data/chroma
# MODELS_DIR=
# VECTORSTORE_PERSIST_DIR=

VECTORSTORE_BACKEND=chroma
KNOWLEDGE_COLLECTION=wathiqa_knowledge

LANGGRAPH_PORT=2024
FRONTEND_PORT=5173
STREAMLIT_PORT=8501

CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:2024,http://127.0.0.1:2024,https://arabicocrragagent.vercel.app,https://smith.langchain.com

# Vite (loaded from repo root via frontend/vite.config.ts envDir)
# VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024
VITE_LANGGRAPH_ASSISTANT_ID=agent
VITE_STACK_VECTOR_DB=Chroma · src/data/chroma
VITE_STACK_EMBEDDINGS=BAAI/bge-m3
VITE_STACK_OCR=Digital text (pypdf)
